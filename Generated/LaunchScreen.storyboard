                        <rect key="frame" x="0" y="0" width="393" height="852"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchIconGradientPlayTransparent" translatesAutoresizingMaskIntoConstraints="NO" id="launch-icon">
                                <rect key="frame" x="116.5" y="346" width="160" height="160"/>
