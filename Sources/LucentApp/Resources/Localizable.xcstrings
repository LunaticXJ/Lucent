        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低於開始比例時不保存續播點；達到完成比例後標記已看完，下次從頭播放。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
