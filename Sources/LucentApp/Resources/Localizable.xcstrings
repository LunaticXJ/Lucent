    "搜索需 API Key；登录可使用账户下载额度。登录状态约 24 小时后需更新。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索需 API Key；登录可使用账户下载额度。登录状态约 24 小时后需更新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searching requires an API key. Sign in to use your download allowance. Sign in again after about 24 hours."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索需 API Key；登錄可使用賬戶下載額度。登錄狀態約 24 小時後需更新。"
          }
        }
